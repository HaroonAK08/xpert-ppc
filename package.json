{
  "name": "xpertppc",
  "version": "1.0.0",
  "private": true,
  "description": "Xpert PPC website — Next.js frontend + Express/MongoDB backend",
  "workspaces": [
    "frontend",
    "backend",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "build:frontend": "npm --workspace frontend run build",
    "build:backend": "npm --workspace backend run build",
    "start": "concurrently -n backend,frontend -c cyan,magenta \"npm:start:backend\" \"npm:start:frontend\"",
    "start:frontend": "npm --workspace frontend run start",
    "start:backend": "npm --workspace backend run start",
    "seed": "npm --workspace backend run seed",
    "test:backend": "npm --workspace backend run test",
    "typecheck": "npm --workspace backend run typecheck && npm --workspace frontend run typecheck && npm --workspace apps/mobile run typecheck",
    "lint": "npm --workspace frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
