# Copy to .env.local and fill in real values.

# The xpertppc-backend API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Hostinger: NEXT_PUBLIC_API_URL=https://api.xpertppc.com

# Images use the backend's upload storage; no third-party upload token is needed.
# Keep backend uploads on persistent storage and include them in backups.
# Alternatively configure the backend's existing S3-compatible object storage.
