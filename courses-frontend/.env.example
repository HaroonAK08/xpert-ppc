# Copy to .env.local and fill in real values.

# The xpertppc-backend API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Hostinger: NEXT_PUBLIC_API_URL=https://api.xpertppc.com

# Search Atlas Content Assistant — server-only (never NEXT_PUBLIC_*)
SEARCHATLAS_CA_HOST=https://ca.staging.searchatlas.com
SEARCHATLAS_TOKEN=Bearer <your-token-here>
