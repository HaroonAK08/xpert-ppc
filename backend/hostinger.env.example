NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/xpertppc?retryWrites=true&w=majority
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://xpertppc.com,https://www.xpertppc.com,https://xpertppc.io,https://www.xpertppc.io
PUBLIC_SITE_URL=https://xpertppc.com
COURSES_SITE_URL=https://xpertppc.io
API_PUBLIC_URL=https://api.xpertppc.com
LEAD_NOTIFY_TO=umer@xpertppc.com
COURSES_NOTIFY_TO=umer@xpertppc.io

# Lead/contact form notifications (xpertppc.com) — Gmail/Google Workspace mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=umer@xpertppc.com
SMTP_PASS=
SMTP_FROM="Xpert PPC <team@xpertppc.com>"

# Digital Academy mail — OTP codes, course applications, accept/reject
# (xpertppc.io) — Hostinger mailbox. Falls back to SMTP_* above if left unset.
ACADEMY_SMTP_HOST=smtp.hostinger.com
ACADEMY_SMTP_PORT=465
ACADEMY_SMTP_SECURE=true
ACADEMY_SMTP_USER=umer@xpertppc.io
ACADEMY_SMTP_PASS=
ACADEMY_SMTP_FROM="XpertPPC Academy <umer@xpertppc.io>"
ACADEMY_SMTP_OTP_FROM="XpertPPC Academy <umer@xpertppc.io>"

CRON_SECRET=
SEQUENCE_CHECK_INTERVAL_MS=300000
SHEET_SYNC_INTERVAL_MS=300000
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
