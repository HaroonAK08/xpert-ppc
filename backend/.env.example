# ---------------------------------------------------------------------------
# Copy to backend/.env and fill in real values. Never commit .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/xpertppc
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/xpertppc?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/xpertppc

# Signing key for admin session tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call this API (comma-separated).
# Must include agency + courses frontends in production, e.g.:
# CORS_ORIGINS=https://xpertppc.com,https://xpertppc.net,https://www.xpertppc.com,https://www.xpertppc.net
# Add the standalone CRM app's own domain too once it has one, e.g. https://crm.xpertppc.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Only set in production when the API and site share a parent domain
# (e.g. .xpertppc.com) so the session cookie is sent to both.
# COOKIE_DOMAIN=.xpertppc.com

# Optional: creates the first admin user when you run `npm run seed`.
# Remove these once the account exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Umer Khan
# Optional second admin (e.g. umer@xpertppc.com)
SEED_ADMIN_EMAIL_2=
SEED_ADMIN_PASSWORD_2=
SEED_ADMIN_NAME_2=Umer Khan

# Optional: creates a verified student for local course-portal testing.
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
SEED_STUDENT_NAME=Student

# ---------------------------------------------------------------------------
# Lead form email notifications
# Every form submission is emailed to LEAD_NOTIFY_TO.
# Without SMTP_* set, leads still save to MongoDB but no email is sent.
# ---------------------------------------------------------------------------
LEAD_NOTIFY_TO=umer@xpertppc.com

# Course applications (Accept/Reject email). Keep separate from lead forms if needed.
# COURSES_NOTIFY_TO=umer@xpertppc.io

# Google Workspace / Gmail:
# SMTP_USER is the mailbox we log in with (App Password).
# Course codes are sent FROM team@xpertppc.com.
# Form leads are emailed TO LEAD_NOTIFY_TO (umer@).
# Gmail only allows From: team@ if that address is added as
# "Send mail as" on the SMTP_USER account, or if SMTP_USER is team@.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=umer@xpertppc.com
SMTP_PASS=
SMTP_FROM="Xpert PPC <team@xpertppc.com>"
SMTP_OTP_FROM="Xpert PPC <team@xpertppc.com>"

# Hostinger / cPanel mailbox alternative:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=umer@xpertppc.com
# SMTP_PASS=your-mailbox-password
# SMTP_FROM="Xpert PPC <umer@xpertppc.com>"

# Public agency site URL.
PUBLIC_SITE_URL=https://xpertppc.com

# Courses / Digital Academy site (student apply, login, accept/reject links).
COURSES_SITE_URL=https://xpertppc.net

# ---------------------------------------------------------------------------
# Google Sheets (CRM mobile app sync) — backend only
# Paste the full service-account JSON as a single line, or base64-encode it.
# Share the target spreadsheet with the service account email (Editor).
# Never put this in the mobile app env.
# ---------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Temporary: skip JWT on /api/v1 CRM routes (local mobile testing).
# CRM_AUTH_DISABLED=true

# ---------------------------------------------------------------------------
# Meta (Facebook/Instagram) Lead Ads
# Create an app at developers.facebook.com, add the "Webhooks" + "Facebook Login"
# products, and subscribe the "leadgen" field under Page webhooks.
# Leave any of these blank to keep the feature disabled.
# ---------------------------------------------------------------------------
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v21.0
# Must match the "Verify Token" you set in the Meta App's Webhooks product.
# META_WEBHOOK_VERIFY_TOKEN=
# Where Meta redirects after the OAuth dialog, e.g. https://api.xpertppc.com/api/v1/integrations/meta/oauth-callback
# META_OAUTH_REDIRECT_URI=
# The standalone CRM app's own origin — Meta's callback redirects the browser here afterward.
CRM_APP_URL=http://localhost:3100
# This API's own public origin — used for direct links like email unsubscribe.
API_PUBLIC_URL=http://localhost:5000
# How often due email-sequence steps are sent, in ms. 0 disables the scheduler.
SEQUENCE_CHECK_INTERVAL_MS=300000
# Encrypts stored Page access tokens at rest. Generate with: openssl rand -base64 48
# META_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Course portal
# Students apply (name, email, password, what they want to learn).
# Umer gets that email and can accept or reject. No OTP to applicants.
# Uploaded lesson files are stored in backend/uploads and served at /uploads.
# ---------------------------------------------------------------------------
