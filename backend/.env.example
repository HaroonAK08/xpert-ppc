# ---------------------------------------------------------------------------
# Copy to backend/.env and fill in real values. Never commit .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/xpertppc
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/xpertppc?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/xpertppc

# Signing key for admin session tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call this API (comma-separated).
# Must include the frontend origin, or admin login will fail CORS.
CORS_ORIGINS=http://localhost:3000

# Only set in production when the API and site share a parent domain
# (e.g. .xpertppc.com) so the session cookie is sent to both.
# COOKIE_DOMAIN=.xpertppc.com

# Optional: creates the first admin user when you run `npm run seed`.
# Remove these once the account exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Umer Khan
