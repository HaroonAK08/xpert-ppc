# Copy to .env.local for local dev.

# The existing xpertppc-backend API — same one the marketing site's /admin and
# the mobile app already use. No separate backend for this app.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Where the embeddable form snippet (embed.js) is actually hosted — the
# marketing site, not this app. Used only to show the correct copy-paste snippet.
NEXT_PUBLIC_MARKETING_SITE_URL=http://localhost:3000
