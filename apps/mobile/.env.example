EXPO_PUBLIC_API_URL=http://localhost:5000

# Android emulator → host machine API:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Physical device on same LAN → use your computer's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

# Production APK (Contabo):
# EXPO_PUBLIC_API_URL=https://xpertppc.com
