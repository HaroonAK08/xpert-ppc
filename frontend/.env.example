# ---------------------------------------------------------------------------
# Copy to frontend/.env.local and fill in real values. Never commit .env.local
# ---------------------------------------------------------------------------

# Public site origin — drives canonical URLs, sitemap.xml, and Open Graph tags.
# Must be the real production origin or SEO metadata points at the wrong host.
NEXT_PUBLIC_SITE_URL=https://xpertppc.com

# Base URL of the Express backend (backend/).
# Local:      http://localhost:5000
# Production: https://api.xpertppc.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Tag Manager container ID (preferred). Load GA4 / Ads / pixels inside GTM.
# Previous live site used: GTM-5SM4JRDT
NEXT_PUBLIC_GTM_ID=

# Direct GA4 measurement ID — only used when NEXT_PUBLIC_GTM_ID is empty.
# Prefer configuring GA4 inside GTM so tags are not double-fired.
# Previous live site used: G-572K4T3EGC
NEXT_PUBLIC_GA_ID=

# Optional Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
